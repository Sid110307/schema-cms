{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Schema CMS",
	"version": "2.0.0",
	"identifier": "dev.sid110307.schema-cms",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Schema CMS",
				"width": 1300,
				"height": 850,
				"minWidth": 720,
				"minHeight": 520,
				"center": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": []
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
